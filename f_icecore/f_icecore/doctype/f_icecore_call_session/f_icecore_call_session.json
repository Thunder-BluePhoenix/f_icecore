{
 "autoname": "format:CALL-{YYYY}-{#####}",
 "creation": "2025-01-14 00:00:00",
 "doctype": "DocType",
 "engine": "InnoDB",
 "field_order": ["from_user", "to_user", "call_type", "priority", "status", "creation", "accepted_at", "ended_at", "duration", "end_reason"],
 "fields": [
  {"fieldname": "from_user", "fieldtype": "Link", "label": "From User", "options": "User", "reqd": 1},
  {"fieldname": "to_user", "fieldtype": "Link", "label": "To User", "options": "User", "reqd": 1},
  {"fieldname": "call_type", "fieldtype": "Select", "label": "Call Type", "options": "audio\nvideo\nscreen", "reqd": 1},
  {"fieldname": "priority", "fieldtype": "Check", "label": "Urgent/Priority Call", "default": 0},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Ringing\nActive\nEnded\nRejected", "default": "Ringing"},
  {"fieldname": "accepted_at", "fieldtype": "Datetime", "label": "Accepted At"},
  {"fieldname": "ended_at", "fieldtype": "Datetime", "label": "Ended At"},
  {"fieldname": "duration", "fieldtype": "Int", "label": "Duration (seconds)"},
  {"fieldname": "end_reason", "fieldtype": "Small Text", "label": "End Reason"},
  {"fieldname": "metadata", "fieldtype": "Long Text", "label": "Metadata"},
  {"fieldname": "quality_metrics", "fieldtype": "Long Text", "label": "Quality Metrics"}
 ],
 "module": "F Icecore",
 "name": "F IceCore Call Session",
 "naming_rule": "Expression",
 "permissions": [{"create": 1, "read": 1, "write": 1, "role": "All"}],
 "sort_field": "creation",
 "sort_order": "DESC",
 "track_changes": 1
}
